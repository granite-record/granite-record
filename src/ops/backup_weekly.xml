<?xml version="1.0" encoding="UTF-8"?>
<!-- The laptop's weekly backup (src/ops/backup_weekly.py), for Task Scheduler. Not for
     importing as it stands: backup_weekly.py, given its task-xml option and a FILE, writes
     it for a checkout, in the UTF-16 schtasks reads, and prints the command that registers
     it. Its settings are the captions inbox's (src/ops/README.md): run whether the person
     is logged on or not, on battery too, waking the laptop, and as soon as possible after
     a start that was missed. -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Granite Record: the weekly backup of everything git does not hold, to the private R2 bucket, then a sample restore when one is due (src\ops\backup_weekly.py; its log is logs\backup-weekly.log).</Description>
    <URI>\Granite Record weekly backup</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <LogonType>Password</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT6H</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <WakeToRun>true</WakeToRun>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-11-22T05:30:00</StartBoundary>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Sunday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>cmd</Command>
      <Arguments>/c cd /d "@CHECKOUT@" &amp;&amp; python3 -X utf8 src\ops\backup_weekly.py &gt;&gt; logs\backup-weekly.log 2&gt;&amp;1</Arguments>
    </Exec>
  </Actions>
</Task>
