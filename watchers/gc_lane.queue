# Then everything else a year holds -- resolutions, addresses, petitions --
# newest first. Floor resolutions (LSR 8000 and up) have no text and are
# never asked; 404s go on the gone-list and a run stops at ten.
fetch_legislation.py --all --from 1989 --to 2024 --newest-first --delay 20 --budget 400 --note everything-else-01
watchers/rest.py 3600 after-everything-else-01
fetch_legislation.py --all --from 1989 --to 2024 --newest-first --delay 20 --budget 400 --note everything-else-02
